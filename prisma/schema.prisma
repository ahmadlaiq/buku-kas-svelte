// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  nama        String   @unique
  deskripsi   String?
  is_aktif    Boolean  @default(true)
  created_at  DateTime @default(now()) @map("created_at")
  users       User[]
  role_menus  RoleMenu[]

  @@map("roles")
}

model Tenant {
  id         Int      @id @default(autoincrement())
  nama       String   @unique
  alamat     String?
  no_hp      String?
  email      String?
  medsos     String?  // Contoh: "@irna.salon"
  is_aktif   Boolean  @default(true)
  status     String   @default("ACTIVE") // PENDING, ACTIVE, SUSPENDED
  expired_at DateTime?
  bukti_transfer String?
  paket      String   @default("BASIC") // BASIC, PRO, ENTERPRISE
  created_at DateTime @default(now()) @map("created_at")
  users      User[]

  pendapatans       Pendapatan[]
  pengeluarans      Pengeluaran[]
  beban_ops         BebanOperasional[]
  beban_penyusutans BebanPenyusutan[]
  karyawans         Karyawan[]
  customers         Customer[]
  materials         MasterMaterial[]
  stock_logs        StockLog[]
  payments          TenantPayment[]
  activity_logs     ActivityLog[]

  @@map("tenants")
}

model TenantPayment {
  id                Int      @id @default(autoincrement())
  tenant_id         Int
  tenant            Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  bukti_transfer    String?
  jumlah_bulan      Int
  status            String   @default("APPROVED")
  created_at        DateTime @default(now()) @map("created_at")

  @@map("tenant_payments")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  tenant_id   Int
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user_id     Int?
  user        User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  action      String   // "CREATE", "UPDATE", "DELETE"
  entity      String   // "Master Material", "Pendapatan", dll
  details     String?  
  created_at  DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  full_name  String   @map("full_name")
  role_id    Int?     @map("role_id")
  tenant_id  Int?     @map("tenant_id")
  is_aktif   Boolean  @default(true)
  role       Role?    @relation(fields: [role_id], references: [id])
  tenant     Tenant?  @relation(fields: [tenant_id], references: [id])
  created_at DateTime @default(now()) @map("created_at")

  pendapatans       Pendapatan[]
  pengeluarans      Pengeluaran[]
  beban_ops         BebanOperasional[]
  beban_penyusutans BebanPenyusutan[]
  karyawans         Karyawan[]
  customers         Customer[]
  materials         MasterMaterial[]
  stock_logs        StockLog[]
  activity_logs     ActivityLog[]

  @@map("users")
}

model Pendapatan {
  id         Int      @id @default(autoincrement())
  tanggal    DateTime
  deskripsi  String?
  jumlah     Float
  tenant_id  Int      @map("tenant_id")
  user_id    Int      @map("user_id")
  tenant     Tenant   @relation(fields: [tenant_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])
  created_at DateTime @default(now()) @map("created_at")

  details    PendapatanDetail[]

  @@map("pendapatan")
}

model PendapatanDetail {
  id             Int            @id @default(autoincrement())
  pendapatan_id  Int            @map("pendapatan_id")
  material_id    Int            @map("material_id")
  karyawan_id    Int?           @map("karyawan_id")
  qty            Int
  harga_satuan   Float          @map("harga_satuan")
  subtotal       Float
  kategori       String?
  created_at     DateTime       @default(now()) @map("created_at")

  pendapatan     Pendapatan     @relation(fields: [pendapatan_id], references: [id], onDelete: Cascade)
  material       MasterMaterial @relation(fields: [material_id], references: [id])
  karyawan       Karyawan?      @relation(fields: [karyawan_id], references: [id])

  @@map("pendapatan_detail")
}

model Pengeluaran {
  id         Int      @id @default(autoincrement())
  tanggal    DateTime
  kategori   String
  deskripsi  String?
  jumlah     Float
  tenant_id  Int      @map("tenant_id")
  user_id    Int      @map("user_id")
  tenant     Tenant   @relation(fields: [tenant_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])
  created_at DateTime @default(now()) @map("created_at")

  @@map("pengeluaran")
}

model BebanOperasional {
  id         Int      @id @default(autoincrement())
  tanggal    DateTime
  kategori   String
  deskripsi  String?
  jumlah     Float
  tenant_id  Int      @map("tenant_id")
  user_id    Int      @map("user_id")
  tenant     Tenant   @relation(fields: [tenant_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])
  created_at DateTime @default(now()) @map("created_at")

  @@map("beban_operasional")
}

model BebanPenyusutan {
  id               Int      @id @default(autoincrement())
  tanggal          DateTime
  nama_aset        String   @map("nama_aset")
  nilai_aset       Float    @map("nilai_aset")
  umur_ekonomis    Int      @map("umur_ekonomis")
  nilai_penyusutan Float    @map("nilai_penyusutan")
  tenant_id        Int      @map("tenant_id")
  user_id          Int      @map("user_id")
  tenant           Tenant   @relation(fields: [tenant_id], references: [id])
  user             User     @relation(fields: [user_id], references: [id])
  created_at       DateTime @default(now()) @map("created_at")

  @@map("beban_penyusutan")
}

model Karyawan {
  id         Int      @id @default(autoincrement())
  nama       String
  no_hp      String?
  posisi     String?
  is_aktif   Boolean  @default(true)
  tenant_id  Int      @map("tenant_id")
  user_id    Int      @map("user_id")
  tenant     Tenant   @relation(fields: [tenant_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])
  created_at DateTime @default(now()) @map("created_at")

  pendapatan_details PendapatanDetail[]

  @@map("karyawan")
}

model Customer {
  id         Int      @id @default(autoincrement())
  nama       String
  no_hp      String?
  alamat     String?
  is_aktif   Boolean  @default(true)
  tenant_id  Int      @map("tenant_id")
  user_id    Int      @map("user_id")
  tenant     Tenant   @relation(fields: [tenant_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])
  created_at DateTime @default(now()) @map("created_at")

  @@map("customer")
}

model MasterMaterial {
  id         Int      @id @default(autoincrement())
  jenis      String   // Akan berisi "JASA" atau "BARANG"
  kategori   String?  // Contoh: "Nail Art", "Hair Treatment", "Produk", "Potong Rambut"
  tipe_barang String? // "Habis Pakai" atau "Dijual" (khusus untuk jenis BARANG)
  nama       String   @unique
  harga      Float?   // Harga standar
  stock      Int      @default(0)
  barcode    String?  @unique
  is_aktif   Boolean  @default(true)
  tenant_id  Int      @map("tenant_id")
  user_id    Int      @map("user_id")
  tenant     Tenant   @relation(fields: [tenant_id], references: [id])
  user       User     @relation(fields: [user_id], references: [id])
  created_at DateTime @default(now()) @map("created_at")
  stock_logs StockLog[]
  pendapatan_details PendapatanDetail[]
  batches    MaterialBatch[]

  @@map("master_material")
}

model MaterialBatch {
  id          Int            @id @default(autoincrement())
  material_id Int
  material    MasterMaterial @relation(fields: [material_id], references: [id], onDelete: Cascade)
  stock       Int            @default(0)
  expired_at  DateTime?
  created_at  DateTime       @default(now()) @map("created_at")
  updated_at  DateTime       @updatedAt @map("updated_at")

  @@map("material_batch")
}

model StockLog {
  id             Int            @id @default(autoincrement())
  material_id    Int
  material       MasterMaterial @relation(fields: [material_id], references: [id], onDelete: Cascade)
  jenis          String         // "IN" (Tambah), "OUT" (Kurang/Jual), "ADJUST" (Penyesuaian Manual)
  jumlah         Int            // Jumlah perubahan (positif atau negatif)
  stok_sebelum   Int            // Stok sebelum perubahan
  stok_sesudah   Int            // Stok setelah perubahan
  keterangan     String?
  latitude       Float?
  longitude      Float?
  tenant_id      Int            @map("tenant_id")
  user_id        Int            @map("user_id")
  tenant         Tenant         @relation(fields: [tenant_id], references: [id])
  user           User           @relation(fields: [user_id], references: [id])
  created_at     DateTime       @default(now()) @map("created_at")

  @@map("stock_logs")
}

model Menu {
  id         Int        @id @default(autoincrement())
  nama       String
  path       String
  icon       String?
  urutan     Int        @default(0)
  is_aktif   Boolean    @default(true)
  created_at DateTime   @default(now()) @map("created_at")
  role_menus RoleMenu[]

  @@map("menus")
}

model RoleMenu {
  id         Int      @id @default(autoincrement())
  role_id    Int      @map("role_id")
  menu_id    Int      @map("menu_id")
  created_at DateTime @default(now()) @map("created_at")

  role       Role     @relation(fields: [role_id], references: [id], onDelete: Cascade)
  menu       Menu     @relation(fields: [menu_id], references: [id], onDelete: Cascade)

  @@unique([role_id, menu_id])
  @@map("role_menus")
}
