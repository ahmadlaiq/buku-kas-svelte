// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  full_name  String   @map("full_name")
  created_at DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Pendapatan {
  id         Int      @id @default(autoincrement())
  tanggal    DateTime
  kategori   String
  deskripsi  String?
  jumlah     Float
  created_at DateTime @default(now()) @map("created_at")

  @@map("pendapatan")
}

model Pengeluaran {
  id         Int      @id @default(autoincrement())
  tanggal    DateTime
  kategori   String
  deskripsi  String?
  jumlah     Float
  created_at DateTime @default(now()) @map("created_at")

  @@map("pengeluaran")
}

model BebanOperasional {
  id         Int      @id @default(autoincrement())
  tanggal    DateTime
  kategori   String
  deskripsi  String?
  jumlah     Float
  created_at DateTime @default(now()) @map("created_at")

  @@map("beban_operasional")
}

model BebanPenyusutan {
  id               Int      @id @default(autoincrement())
  tanggal          DateTime
  nama_aset        String   @map("nama_aset")
  nilai_aset       Float    @map("nilai_aset")
  umur_ekonomis    Int      @map("umur_ekonomis")
  nilai_penyusutan Float    @map("nilai_penyusutan")
  created_at       DateTime @default(now()) @map("created_at")

  @@map("beban_penyusutan")
}

model Karyawan {
  id         Int      @id @default(autoincrement())
  nama       String
  no_hp      String?
  posisi     String?
  is_aktif   Boolean  @default(true)
  created_at DateTime @default(now()) @map("created_at")

  @@map("karyawan")
}

model Customer {
  id         Int      @id @default(autoincrement())
  nama       String
  no_hp      String?
  alamat     String?
  is_aktif   Boolean  @default(true)
  created_at DateTime @default(now()) @map("created_at")

  @@map("customer")
}

model MasterMaterial {
  id         Int      @id @default(autoincrement())
  jenis      String   // Akan berisi "JASA" atau "BARANG"
  kategori   String?  // Contoh: "Nail Art", "Hair Treatment", "Produk", "Potong Rambut"
  nama       String   @unique
  harga      Float?   // Harga standar
  stock      Int      @default(0)
  barcode    String?  @unique
  is_aktif   Boolean  @default(true)
  created_at DateTime @default(now()) @map("created_at")
  stock_logs StockLog[]

  @@map("master_material")
}

model StockLog {
  id             Int            @id @default(autoincrement())
  material_id    Int
  material       MasterMaterial @relation(fields: [material_id], references: [id], onDelete: Cascade)
  jenis          String         // "IN" (Tambah), "OUT" (Kurang/Jual), "ADJUST" (Penyesuaian Manual)
  jumlah         Int            // Jumlah perubahan (positif atau negatif)
  stok_sebelum   Int            // Stok sebelum perubahan
  stok_sesudah   Int            // Stok setelah perubahan
  keterangan     String?
  latitude       Float?
  longitude      Float?
  created_at     DateTime       @default(now()) @map("created_at")

  @@map("stock_log")
}
